          "id": "952c8b68-0800-4351-8355-be8c6b618b1a",
          "name": "Get Charges Table Summary",
          "request": {
            "name": "Get Charges Table Summary",
            "description": {
              "content": "Returns aggregate summary values for the charges table using the requested filters and aggregations, without returning full row detail. Downstream finance systems can use this endpoint to validate export scope, reconcile totals, and compare Cedar results against imported batches in NetSuite, Sage, or another ERP.\n\nCommon reconciliation patterns:\n\n| Aggregate request | Typical downstream use |\n| --- | --- |\n| `COUNT` on `chargeId` | Confirm the number of charges in an export batch. |\n| `SUM` on `amount` | Compare Cedar totals with external invoice or journal totals. |\n| `SUM` on `adjustment_total` | Measure the net effect of adjustments before posting. |\n| `MIN` / `MAX` on `appliedAt` | Verify the date window covered by an incremental export. |\n\nUse the same filter set you would pass to `List Charges Table Rows` when you want summary numbers for the exact same population of charges.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "t",
                "v1",
                "charges-table-summary"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) Carrier ID",
                "key": "Carrier",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"aggregates\": [\n    {\n      \"columnKey\": \"<string>\",\n      \"op\": \"AO_UNSPECIFIED\"\n    },\n    {\n      \"columnKey\": \"<string>\",\n      \"op\": \"AO_UNSPECIFIED\"\n    }\n  ],\n  \"filters\": [\n    {\n      \"columnKey\": \"<string>\",\n      \"op\": \"RO_DEFAULT\",\n      \"searchTerm\": \"<string>\"\n    },\n    {\n      \"columnKey\": \"<string>\",\n      \"op\": \"RO_DEFAULT\",\n      \"searchTerm\": \"<string>\"\n    }\n  ]\n}",
